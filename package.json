{
  "name": "dsh-llm-wiki",
  "version": "0.13.7",
  "description": "Karpathy LLM Wiki 模式的 DSH 知识库系统：wiki-write/wiki-search SKILL + 零依赖管线 + mnemon 记忆体召回 + 图形管理面板（配置项 / 凭据 / 计划任务 / 运行历史）。以本地仓库 link 方式安装，改代码重启即生效。",
  "type": "module",
  "main": "plugin/dsh-llm-wiki.mjs",
  "exports": {
    ".": "./plugin/dsh-llm-wiki.mjs",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "llm-wiki",
    "obsidian",
    "knowledge-management",
    "karpathy"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "test": "node test/profile-detect.mjs && node test/panel-e2e.mjs && node scripts/eval-profile.mjs && node scripts/eval-retrieval.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
